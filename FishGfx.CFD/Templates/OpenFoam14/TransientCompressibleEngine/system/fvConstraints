FoamFile { format ascii; class dictionary; location "system"; object fvConstraints; }

limitU
{
    type            limitMag;
    cellZone        all;
    field           U;
    max             {{MAX_VELOCITY}};
}

// Keep the ideal-gas state strictly physical during sharp exhaust-pulse
// reversals.  In particular, omegaWallFunction evaluates nu = mu/rho before
// its viscous/log-law branch selection, so a zero or negative transient rho
// can otherwise raise SIGFPE even when the pressure solve subsequently
// recovers.  These broad safety limits are well outside the intended A14NET
// operating range and therefore only engage during a numerical excursion.
boundP
{
    type            bound;
    field           p;
    min             1000;
}

limitP
{
    type            limitMag;
    cellZone        all;
    field           p;
    max             5000000;
}

boundRho
{
    type            bound;
    field           rho;
    min             0.001;
}

limitRho
{
    type            limitMag;
    cellZone        all;
    field           rho;
    max             50;
}

boundK
{
    type            bound;
    field           k;
    min             1e-10;
}

limitK
{
    type            limitMag;
    cellZone        all;
    field           k;
    max             {{MAX_TURBULENT_K}};
}

boundOmega
{
    type            bound;
    field           omega;
    min             1e-6;
}

limitOmega
{
    type            limitMag;
    cellZone        all;
    field           omega;
    max             1e8;
}

limitT
{
    type            limitTemperature;
    cellZone        all;
    min             250;
    max             1800;
}
