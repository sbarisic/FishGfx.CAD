FoamFile { format ascii; class dictionary; location "system"; object fvSolution; }
solvers
{
    p
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-7;
        relTol 0.05;
    }
    pFinal { $p; relTol 0; }
    Phi { $p; }
    "(rho|U|k|omega|e|h)"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-7;
        relTol 0.05;
    }
    "(rho|U|k|omega|e|h)Final"
    {
        solver smoothSolver;
        smoother symGaussSeidel;
        tolerance 1e-7;
        relTol 0;
    }
}
PIMPLE
{
    nOuterCorrectors 2;
    nCorrectors 2;
    nNonOrthogonalCorrectors 0;
    momentumPredictor yes;
}
