<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseSystemDrawing>true</UseSystemDrawing>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <CadNativeSourceRoot>$(MSBuildThisFileDirectory)..\FishGfx.CadKernel.Native</CadNativeSourceRoot>
    <CadNativeBuildRoot>$(CadNativeSourceRoot)\out\build\windows-x64</CadNativeBuildRoot>
    <CadNativeRuntimeDir>$(CadNativeBuildRoot)\$(Configuration)</CadNativeRuntimeDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\FishGfx\FishGfx\FishGfx.csproj" />
    <ProjectReference Include="..\external\FishGfx\FishGfx.FishUI\FishGfx.FishUI.csproj" />
    <ProjectReference Include="..\FishGfx.CadKernel\FishGfx.CadKernel.csproj" />
    <ProjectReference Include="..\FishGfx.Im3d\FishGfx.Im3d.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\external\FishGfx\thirdparty\FishUI\FishUI\data\**\*"
             Link="data\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyCadNativeRuntimeForCfd" AfterTargets="Build">
    <ItemGroup Condition="Exists('$(CadNativeRuntimeDir)')">
      <CadNativeRuntime Include="$(CadNativeRuntimeDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CadNativeRuntime)" DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" Condition="'@(CadNativeRuntime)' != ''" />
  </Target>
</Project>
